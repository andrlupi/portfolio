---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import EducationCertifications from '../components/EducationCertifications.astro';
import SkillsStack from '../components/SkillsStack.astro';
import { getCollection } from 'astro:content';
import { getUrl } from '../utils/url';

const projects = await getCollection('projects');
const sortedProjects = projects.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
const emaProject = sortedProjects.find((p) => p.slug === 'ema-cryo');
const tutorProject = sortedProjects.find((p) => p.slug === 'multi-ai-tutor');
---

<Layout
  title="André Luiz Pianca | Físico & Engenheiro Físico (UNICAMP)"
  description="Física e Engenharia · Processos, Qualidade, Instrumentação, Modelagem e Simulação · UNICAMP"
>
  <Hero />

  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-12 space-y-20">
    <!-- Destaques: Projetos de Pesquisa, Engenharia & IA -->
    <section id="projetos-destaque" class="space-y-8 scroll-mt-20">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 border-b border-ctp-surface0 pb-4">
        <div>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-ctp-sapphire"></span>
            <span class="text-xs font-bold uppercase tracking-wider text-ctp-sky font-mono">Pesquisa, Engenharia &amp; IA</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-ctp-text mt-1">
            Projetos &amp; Desenvolvimento em Destaque
          </h2>
        </div>
        <a
          href={getUrl('/projetos')}
          class="text-xs font-bold text-ctp-sky hover:text-ctp-teal flex items-center gap-1.5 transition-colors self-start sm:self-auto"
        >
          <span>Ver todos os projetos</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 gap-8">
        <!-- Projeto 1: EMA-C (Sirius / LNLS) -->
        {emaProject && (
          <ProjectCard
            title={emaProject.data.title}
            slug={emaProject.slug}
            tagline={emaProject.data.tagline}
            description={emaProject.data.description}
            tags={emaProject.data.tags}
            category={emaProject.data.category}
            metrics={emaProject.data.metrics}
            coverImage={emaProject.data.coverImage}
            repoUrl={emaProject.data.repoUrl}
            featured={true}
          />
        )}

        <!-- Projeto 2: Multi-AI-Tutor (Google Gemini & Antigravity) -->
        {tutorProject && (
          <ProjectCard
            title={tutorProject.data.title}
            slug={tutorProject.slug}
            tagline={tutorProject.data.tagline}
            description={tutorProject.data.description}
            tags={tutorProject.data.tags}
            category={tutorProject.data.category}
            metrics={tutorProject.data.metrics}
            coverImage={tutorProject.data.coverImage}
            repoUrl={tutorProject.data.repoUrl}
            featured={true}
          />
        )}
      </div>
    </section>

    <!-- Experiência Profissional & Atuação -->
    <ExperienceTimeline />

    <!-- Formação Acadêmica & Certificações Internacionais -->
    <EducationCertifications />

    <!-- Competências & Stack Técnico (Abas & Pills) -->
    <SkillsStack />

    <!-- CTA / Contato Rápido -->
    <section class="glass-panel p-8 sm:p-12 text-center bg-gradient-to-b from-ctp-mantle to-ctp-crust border border-ctp-sapphire/40 rounded-3xl relative overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_50%_50%_at_50%_50%,rgba(116,199,236,0.08),rgba(255,255,255,0))] pointer-events-none"></div>

      <div class="relative z-10 max-w-2xl mx-auto space-y-4">
        <span class="text-xs font-bold uppercase tracking-wider text-ctp-sky font-mono">Vamos Conversar?</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-ctp-text">
          Disponível para Pesquisa, P&amp;D e Projetos de Alta Complexidade
        </h2>
        <p class="text-xs sm:text-sm text-ctp-subtext1 leading-relaxed">
          Seja para discutir desafios em criogenia, instrumentação científica, verificação e validação de hardware ou inteligência artificial em STEM, conecte-se comigo pelo LinkedIn ou GitHub.
        </p>
        <div class="pt-2 flex flex-wrap justify-center gap-3">
          <a
            href="https://linkedin.com/in/andre-lpianca"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 rounded-xl text-xs sm:text-sm font-extrabold text-ctp-crust bg-ctp-sapphire hover:bg-ctp-sky transition-all shadow-lg shadow-ctp-sapphire/20 flex items-center gap-2"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.6 1.6 0 1 0 0-3.2 1.6 1.6 0 0 0 0 3.2m1.4 9.74V10.13H5.06v8.37h2.8z" />
            </svg>
            <span>Conectar via LinkedIn</span>
          </a>
          <a
            href="https://github.com/andrlupi"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 rounded-xl text-xs sm:text-sm font-semibold text-ctp-text bg-ctp-surface0 hover:bg-ctp-surface1 border border-ctp-surface1 transition-all flex items-center gap-2"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
            <span>Ver GitHub (@andrlupi)</span>
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
