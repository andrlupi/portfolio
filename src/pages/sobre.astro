---
import Layout from '../layouts/Layout.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import EducationCertifications from '../components/EducationCertifications.astro';
import SkillsStack from '../components/SkillsStack.astro';
---

<Layout
  title="Sobre & Trajetória | André Luiz Pianca"
  description="Física e Engenharia · Processos, Qualidade, Instrumentação, Modelagem e Simulação · UNICAMP"
>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 py-12 space-y-16">
    <!-- Cabeçalho do Perfil -->
    <section class="space-y-6 border-b border-slate-800 pb-10">
      <div class="flex flex-wrap items-center gap-2">
        <span class="badge-tech">Física e Engenharia</span>
        <span class="badge-dark">Processos &bull; Qualidade &bull; Dispositivos Médicos</span>
        <span class="badge-dark">UNICAMP &bull; Campinas, SP</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-black text-white leading-tight">
        André Luiz Pianca
      </h1>

      <p class="text-sm sm:text-base font-semibold text-cyan-400 font-mono">
        Física e Engenharia &bull; Processos, Qualidade, Instrumentação, Modelagem e Simulação &bull; UNICAMP
      </p>

      <!-- Resumo Profissional do Currículo -->
      <div class="p-6 rounded-2xl bg-[#0c1322]/80 border border-slate-800 space-y-3">
        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-300 font-mono flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
          Resumo Profissional
        </h2>
        <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
          Físico e Engenheiro Físico em formação pela UNICAMP, com sólida base em modelagem física, simulações computacionais e instrumentação científica. Sou um profissional apaixonado por transformar desafios físicos complexos em soluções de inovação tecnológica que geram impacto real. Com histórico no desenvolvimento de sistemas criogênicos e experiência no ensino, busco aplicar minha curiosidade técnica e visão analítica para impulsionar projetos de P&amp;D que agreguem valor estratégico.
        </p>
      </div>

      <!-- Cartão de Contato e Identificadores -->
      <div class="glass-panel p-5 bg-[#0c1322]/80 border-slate-800 grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
        <div class="space-y-2">
          <div class="flex items-center gap-2 text-slate-300">
            <span class="text-cyan-400 font-bold font-mono">E-mail:</span>
            <a href="mailto:andre-lpianca@proton.me" class="hover:text-cyan-300 text-slate-200 underline decoration-slate-700">
              andre-lpianca@proton.me
            </a>
          </div>
          <div class="flex items-center gap-2 text-slate-300">
            <span class="text-cyan-400 font-bold font-mono">Localização:</span>
            <span>Campinas, São Paulo &bull; Brasil</span>
          </div>
        </div>

        <div class="space-y-2">
          <div class="flex items-center gap-2 text-slate-300">
            <span class="text-cyan-400 font-bold font-mono">ORCID:</span>
            <a href="https://orcid.org/0009-0005-9084-688X" target="_blank" rel="noopener noreferrer" class="hover:text-cyan-300 text-slate-200 underline decoration-slate-700">
              0009-0005-9084-688X
            </a>
          </div>
          <div class="flex items-center gap-2 text-slate-300">
            <span class="text-cyan-400 font-bold font-mono">GitHub:</span>
            <a href="https://github.com/andrlupi" target="_blank" rel="noopener noreferrer" class="hover:text-cyan-300 text-slate-200 underline decoration-slate-700">
              github.com/andrlupi
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Linha do Tempo Profissional (Hardware BR, Museu, CNPEM) -->
    <ExperienceTimeline />

    <!-- Formação Acadêmica & Certificações (Eng. Física Dez/2028, Física Jul/2027, COTIL) -->
    <EducationCertifications />

    <!-- Atividades Extracurriculares (F 259, F 489, Atlética) -->
    <section class="space-y-6">
      <div class="border-b border-slate-800 pb-3">
        <span class="text-xs font-bold uppercase tracking-wider text-cyan-400 font-mono">Ensino &amp; Integração Universitária</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white mt-1">Atividades Extracurriculares</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <!-- Monitoria F 259 -->
        <div class="glass-panel p-5 bg-[#0c1322]/80 border-slate-800 flex flex-col justify-between">
          <div>
            <div class="flex justify-between items-center text-[10px] uppercase tracking-wider font-bold mb-2">
              <span class="text-cyan-300 bg-cyan-500/10 px-2 py-0.5 rounded border border-cyan-500/20">Monitoria</span>
              <span class="text-slate-500 font-mono">ago. 2025 – dez. 2025</span>
            </div>
            <h3 class="text-sm font-bold text-white mb-1">F 259 – Introdução à Física Experimental II</h3>
            <p class="text-[11px] text-cyan-400 font-medium mb-3">Instituto de Física, UNICAMP &bull; Campinas, SP</p>
            <p class="text-xs text-slate-300 leading-relaxed">
              Orientação de grupos acadêmicos na aplicação de metodologias analíticas e no desenvolvimento de relatórios com rigor científico.
            </p>
          </div>
        </div>

        <!-- Monitoria F 489 -->
        <div class="glass-panel p-5 bg-[#0c1322]/80 border-slate-800 flex flex-col justify-between">
          <div>
            <div class="flex justify-between items-center text-[10px] uppercase tracking-wider font-bold mb-2">
              <span class="text-cyan-300 bg-cyan-500/10 px-2 py-0.5 rounded border border-cyan-500/20">Monitoria</span>
              <span class="text-slate-500 font-mono">mar. 2024 – jul. 2024</span>
            </div>
            <h3 class="text-sm font-bold text-white mb-1">F 489 – Estrutura da Matéria II</h3>
            <p class="text-[11px] text-cyan-400 font-medium mb-3">Instituto de Física, UNICAMP &bull; Campinas, SP</p>
            <p class="text-xs text-slate-300 leading-relaxed">
              Facilitação pedagógica e suporte conceitual em tópicos de Física Moderna para estudantes de graduação.
            </p>
          </div>
        </div>

        <!-- Atlética César Lattes -->
        <div class="glass-panel p-5 bg-[#0c1322]/80 border-slate-800 flex flex-col justify-between">
          <div>
            <div class="flex justify-between items-center text-[10px] uppercase tracking-wider font-bold mb-2">
              <span class="text-amber-300 bg-amber-500/10 px-2 py-0.5 rounded border border-amber-500/20">Liderança</span>
              <span class="text-slate-500 font-mono">mar. 2021 – mai. 2023</span>
            </div>
            <h3 class="text-sm font-bold text-white mb-1">Atlética "César Lattes"</h3>
            <p class="text-[11px] text-amber-400 font-medium mb-3">Instituto de Física, UNICAMP &bull; Campinas, SP</p>
            <p class="text-xs text-slate-300 leading-relaxed">
              Gestão operacional de eventos e coordenação logística de competições esportivas, fortalecendo a integração e o trabalho em equipe.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Stack de Habilidades -->
    <SkillsStack />
  </main>
</Layout>
