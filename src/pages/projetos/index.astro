---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const sortedProjects = projects.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
---

<Layout
  title="Projetos & Pesquisa | André Luiz Pianca"
  description="Vitrine de projetos de engenharia física, modelagem térmica computacional em Julia, co-design termo-mecânico e instrumentação científica."
>
  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-12 space-y-10">
    <!-- Header da Página -->
    <div class="border-b border-ctp-surface0 pb-6 space-y-2">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-ctp-sapphire"></span>
        <span class="text-xs font-bold uppercase tracking-wider text-ctp-sky font-mono">Portfólio Técnico</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-ctp-text">Projetos &amp; Desenvolvimento Científico</h1>
      <p class="text-sm sm:text-base text-ctp-subtext0 max-w-2xl leading-relaxed">
        Coleção de projetos autorais e contribuições em pesquisa com foco em modelagem física não-linear, criogenia profunda, instrumentação e co-design termo-mecânico.
      </p>
    </div>

    <!-- Lista de Projetos -->
    <div class="grid grid-cols-1 gap-8">
      {
        sortedProjects.map((project) => (
          <ProjectCard
            title={project.data.title}
            slug={project.slug}
            tagline={project.data.tagline}
            description={project.data.description}
            tags={project.data.tags}
            category={project.data.category}
            metrics={project.data.metrics}
            coverImage={project.data.coverImage}
            repoUrl={project.data.repoUrl}
            featured={project.data.featured}
          />
        ))
      }
    </div>

    <!-- Mensagem de expansão futura -->
    <div class="glass-panel p-6 bg-ctp-mantle/60 border-ctp-surface0 rounded-2xl text-center space-y-2">
      <div class="text-xs font-mono font-semibold text-ctp-sky">&bull; Novos Projetos em Documentação &bull;</div>
      <p class="text-xs text-ctp-subtext0 max-w-lg mx-auto leading-relaxed">
        Projetos adicionais — incluindo ferramentas pedagógicas baseadas em IA para ensino STEM e novas simulações de física — serão integrados nesta seção via coleções de conteúdo do Astro.
      </p>
    </div>
  </main>
</Layout>
