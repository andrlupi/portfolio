---
const experiences = [
  {
    role: "Bolsista – Verificação e Validação (V&V) & Qualidade",
    company: "Instituto Hardware BR",
    period: "jul. 2026 – presente",
    location: "Campinas, SP",
    highlight: "Engenharia de Aplicações & V&V",
    isCurrent: true,
    description: [
      "Atuação no time de Engenharia de Aplicações com foco em Verificação e Validação (V&V) de hardware, em transição da área de Qualidade e Processos.",
      "Apoio à governança institucional e organização de fluxos decisórios técnicos.",
      "Suporte à estruturação do sistema de gestão da qualidade (SGQ), documentação técnica, procedimentos e registros.",
      "Contribuição em assuntos regulatórios na área de dispositivos médicos (documentação técnica e conformidade normativa).",
      "Padronização de processos, ferramentas de qualidade e acompanhamento de indicadores.",
    ],
    tags: ["Verificação & Validação (V&V)", "Engenharia de Aplicações", "Gestão da Qualidade", "Dispositivos Médicos", "Padronização de Processos"],
  },
  {
    role: "Estagiário – Mediação Científica",
    company: "Museu Exploratório de Ciências, UNICAMP",
    period: "mai. 2025 – jul. 2026",
    location: "Campinas, SP",
    highlight: "Divulgação Científica",
    isCurrent: false,
    description: [
      "Condução de demonstrações experimentais de ciências para públicos de diferentes níveis de escolaridade.",
      "Adaptação de conceitos físicos complexos para linguagem acessível ao público geral.",
      "Suporte à logística operacional e atividades educativas do museu.",
    ],
    tags: ["Demonstrações Experimentais", "Didática & Ensino", "Mediação Científica"],
  },
  {
    role: "Estagiário – P&D em Sistemas Criogênicos",
    company: "CNPEM – Centro Nacional de Pesquisa em Energia e Materiais",
    period: "abr. 2023 – dez. 2023",
    location: "Campinas, SP",
    highlight: "Sirius / Linha EMA-nano",
    isCurrent: false,
    description: [
      "Desenvolvimento e validação de modelo térmico lumped-mass para o sistema criogênico da linha EMA-nano, garantindo a previsibilidade de temperatura de operação e tempo de resfriamento do ambiente de experimentos.",
      "Definição estratégica de parâmetros de resistência térmica como constraints de engenharia, antecipando e mitigando restrições de desempenho durante a fase de projeto do sistema.",
      "Divulgação dos resultados obtidos por meio de flash talk durante o V Congresso de Estudantes do CNPEM.",
    ],
    tags: ["Julia", "Modelagem Térmica", "Lumped-Mass", "Criogenia (< 10 K)", "Sirius / LNLS"],
  },
];
---

<section id="experiencia" class="space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 border-b border-ctp-surface0 pb-4">
    <div>
      <span class="text-xs font-bold uppercase tracking-wider text-ctp-sky font-mono">Trajetória Profissional</span>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-ctp-text mt-1">Experiência Profissional</h2>
    </div>
    <p class="text-xs text-ctp-subtext0 max-w-md">
      Atuação em governança da qualidade, dispositivos médicos, infraestrutura criogênica de feixes síncrotron e divulgação científica.
    </p>
  </div>

  <div class="space-y-4 pt-2">
    {
      experiences.map((exp) => (
        <div class="glass-panel p-5 sm:p-6 bg-ctp-mantle/85 border border-ctp-surface0 hover:border-ctp-surface1 transition-all">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
            <div>
              <div class="flex flex-wrap items-center gap-2">
                <span class="text-xs font-bold uppercase tracking-wider text-ctp-sky font-mono">{exp.role}</span>
                {exp.isCurrent && (
                  <span class="text-[10px] px-2 py-0.5 rounded-full bg-ctp-sapphire/20 text-ctp-sky border border-ctp-sapphire/40 font-bold uppercase tracking-wide animate-pulse">
                    Atual
                  </span>
                )}
                <span class="text-[10px] px-2 py-0.5 rounded-full bg-ctp-surface0 text-ctp-subtext1 border border-ctp-surface1 font-semibold">
                  {exp.highlight}
                </span>
              </div>
              <h3 class="text-base sm:text-lg font-extrabold text-ctp-text mt-0.5">{exp.company}</h3>
            </div>
            <div class="text-xs text-ctp-subtext0 font-medium sm:text-right">
              <div>{exp.period}</div>
              <div class="text-[11px] text-ctp-overlay0">{exp.location}</div>
            </div>
          </div>

          <ul class="space-y-2 text-xs sm:text-sm text-ctp-subtext1 mb-4">
            {exp.description.map((bullet) => (
              <li class="flex items-start gap-2">
                <span class="text-ctp-sapphire mt-1">&bull;</span>
                <span class="leading-relaxed">{bullet}</span>
              </li>
            ))}
          </ul>

          <div class="flex flex-wrap gap-1.5 pt-2 border-t border-ctp-surface0/60">
            {exp.tags.map((tag) => (
              <span class="text-[11px] font-medium bg-ctp-surface0/60 text-ctp-subtext0 px-2.5 py-0.5 rounded-md border border-ctp-surface0">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
