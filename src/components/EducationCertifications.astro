---
const degrees = [
  {
    title: "Engenharia Física (Graduação)",
    institution: "Universidade Estadual de Campinas (UNICAMP)",
    status: "Previsão: Dez. 2028",
    emphasis: "Ênfase em Produção Tecnológica",
    details: "Formação multidisciplinar integrando instrumentação física, ciência e tecnologia dos materiais, processos industriais, metrologia e gestão de sistemas tecnológicos complexos.",
  },
  {
    title: "Física (Bacharelado)",
    institution: "Universidade Estadual de Campinas (UNICAMP)",
    status: "Previsão: Jul. 2027",
    emphasis: null,
    details: "Fundamentação teórica e experimental em mecânica quântica, termodinâmica, eletromagnetismo clássico, física do estado sólido e métodos computacionais.",
  },
  {
    title: "Ensino Médio e Técnico em Mecânica",
    institution: "Colégio Técnico de Limeira (COTIL - UNICAMP)",
    status: "Concluído em 2015",
    emphasis: null,
    details: "Formação técnica em processos mecânicos, metrologia, ensaios de materiais, desenho técnico assistido por computador (CAD) e elementos de máquinas.",
  },
];

const certifications = [
  {
    title: "Industrial Internet of Things (IIoT)",
    issuer: "University of Michigan",
    year: "2026",
  },
  {
    title: "Digital Manufacturing & Design",
    issuer: "University at Buffalo",
    year: "2026",
  },
  {
    title: "Advanced Manufacturing Process Analysis",
    issuer: "University at Buffalo",
    year: "2026",
  },
  {
    title: "Digital Thread: Implementation",
    issuer: "University at Buffalo",
    year: "2026",
  },
  {
    title: "Digital Thread: Components",
    issuer: "University at Buffalo",
    year: "2026",
  },
  {
    title: "Data-Driven Decision Making (DDDM)",
    issuer: "The State University of New York (SUNY)",
    year: "2025",
  },
  {
    title: "Qiskit Global Summer School: The Path to Utility",
    issuer: "IBM Quantum",
    year: "2024",
  },
];
---

<section id="formacao" class="grid grid-cols-1 lg:grid-cols-12 gap-8 pt-4">
  <!-- Formação Acadêmica -->
  <div class="lg:col-span-7 space-y-6">
    <div class="border-b border-ctp-surface0 pb-3">
      <span class="text-xs font-bold uppercase tracking-wider text-ctp-sky font-mono">Ensino Superior &amp; Técnico</span>
      <h2 class="text-2xl font-extrabold text-ctp-text mt-1">Formação Acadêmica</h2>
    </div>

    <div class="space-y-3">
      {
        degrees.map((deg) => (
          <div class="glass-panel p-5 bg-ctp-mantle/85 border border-ctp-surface0 hover:border-ctp-surface1 transition-all">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-2">
              <div>
                <h3 class="text-base font-bold text-ctp-text">{deg.title}</h3>
                {deg.emphasis && (
                  <span class="inline-block text-[11px] font-semibold text-ctp-sky mt-0.5">
                    &bull; {deg.emphasis}
                  </span>
                )}
              </div>
              <span class="text-xs font-mono font-bold px-2.5 py-0.5 rounded-full bg-ctp-surface0 text-ctp-sky border border-ctp-sapphire/40 self-start sm:self-auto">
                {deg.status}
              </span>
            </div>
            <div class="text-xs font-semibold text-ctp-subtext1 mb-2">{deg.institution}</div>
            <p class="text-xs text-ctp-subtext0 leading-relaxed">{deg.details}</p>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Certificações -->
  <div class="lg:col-span-5 space-y-6">
    <div class="border-b border-ctp-surface0 pb-3">
      <span class="text-xs font-bold uppercase tracking-wider text-ctp-sky font-mono">Especializações &amp; Cursos</span>
      <h2 class="text-2xl font-extrabold text-ctp-text mt-1">Certificações</h2>
    </div>

    <div class="glass-panel p-4 bg-ctp-mantle/85 border border-ctp-surface0 space-y-3 max-h-[460px] overflow-y-auto">
      {
        certifications.map((cert) => (
          <div class="p-3 rounded-xl bg-ctp-surface0/50 hover:bg-ctp-surface0 border border-ctp-surface0/90 hover:border-ctp-surface1 transition-all flex items-start gap-3">
            <div class="mt-0.5 p-2 rounded-lg bg-ctp-surface0 text-ctp-sky border border-ctp-sapphire/30">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
              </svg>
            </div>
            <div>
              <h4 class="text-xs font-bold text-ctp-text leading-snug">{cert.title}</h4>
              <p class="text-[11px] text-ctp-subtext0 mt-0.5">
                {cert.issuer} &bull; <span class="font-mono text-ctp-sky">{cert.year}</span>
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
