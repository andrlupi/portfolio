---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-slate-800/80 bg-[#05080f] text-slate-400 py-12 px-4 sm:px-6">
  <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
    <!-- Bio / Info -->
    <div class="md:col-span-2 space-y-3">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-cyan-400"></span>
        <h2 class="text-base font-extrabold tracking-wide text-slate-100">ANDRÉ LUIZ PIANCA</h2>
      </div>
      <p class="text-xs text-slate-400 max-w-md leading-relaxed">
        Físico e Engenheiro Físico em formação pela <strong class="text-slate-200">UNICAMP</strong> (IFGW). Foco em modelagem computacional não-linear, criogenia, instrumentação de feixes síncrotron e co-design termo-mecânico de sistemas complexos.
      </p>
      <div class="pt-1 flex items-center gap-2 text-xs text-slate-400">
        <span class="inline-flex items-center gap-1 bg-slate-900 px-2 py-1 rounded border border-slate-800">
          <svg class="w-3.5 h-3.5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          Campinas, SP &bull; Brasil
        </span>
      </div>
    </div>

    <!-- Navegação Rápida -->
    <div class="space-y-3">
      <h3 class="text-xs font-bold uppercase tracking-wider text-slate-200">Navegação</h3>
      <ul class="space-y-2 text-xs">
        <li><a href="/" class="hover:text-cyan-300 transition-colors">Início</a></li>
        <li><a href="/sobre" class="hover:text-cyan-300 transition-colors">Sobre & CV Detalhado</a></li>
        <li><a href="/projetos" class="hover:text-cyan-300 transition-colors">Portfólio de Projetos</a></li>
        <li><a href="/projetos/ema-cryo" class="text-cyan-400 hover:text-cyan-300 transition-colors font-medium">Modelagem EMA-C Sirius &rarr;</a></li>
      </ul>
    </div>

    <!-- Identificadores Científicos & Redes -->
    <div class="space-y-3">
      <h3 class="text-xs font-bold uppercase tracking-wider text-slate-200">Presença Científica</h3>
      <ul class="space-y-2 text-xs">
        <li>
          <a
            href="https://orcid.org/0009-0005-9084-688X"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 hover:text-cyan-300 transition-colors"
          >
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            ORCID: 0009-0005-9084-688X
          </a>
        </li>
        <li>
          <a
            href="https://github.com/andrlupi"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 hover:text-cyan-300 transition-colors"
          >
            <span class="w-2 h-2 rounded-full bg-slate-400"></span>
            GitHub: @andrlupi
          </a>
        </li>
        <li>
          <a
            href="https://linkedin.com/in/andre-lpianca"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 hover:text-cyan-300 transition-colors"
          >
            <span class="w-2 h-2 rounded-full bg-blue-500"></span>
            LinkedIn: in/andre-lpianca
          </a>
        </li>
        <li>
          <a
            href="mailto:andre-lpianca@proton.me"
            class="flex items-center gap-2 hover:text-cyan-300 transition-colors text-slate-300"
          >
            <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
            andre-lpianca@proton.me
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="max-w-6xl mx-auto pt-6 border-t border-slate-900 flex flex-col sm:flex-row items-center justify-between gap-3 text-[11px] text-slate-400">
    <div>
      &copy; {currentYear} André Luiz Pianca. Todos os direitos reservados.
    </div>
    <div class="flex items-center gap-4">
      <span class="text-slate-400">Desenvolvido com Astro &bull; Tailwind CSS &bull; SSG Zero-JS</span>
      <a href="https://github.com/andrlupi/portfolio" target="_blank" rel="noopener noreferrer" class="hover:text-slate-200 underline decoration-slate-700">
        Código-Fonte no GitHub
      </a>
    </div>
  </div>
</footer>
