---
import { getUrl } from '../utils/url';

interface Props {
  title: string;
  slug: string;
  tagline: string;
  description: string;
  tags: string[];
  category: string;
  metrics?: Array<{ label: string; value: string; detail?: string }>;
  coverImage?: string;
  repoUrl?: string;
  featured?: boolean;
}

const {
  title,
  slug,
  tagline,
  description,
  tags,
  category,
  metrics = [],
  coverImage,
  repoUrl,
  featured = false,
} = Astro.props;

const projectUrl = getUrl(`/projetos/${slug}`);
const resolvedCover = coverImage ? getUrl(coverImage) : undefined;
---

<div class={`glass-panel p-6 sm:p-7 bg-[#0c1322]/85 border transition-all flex flex-col justify-between ${
  featured ? 'border-cyan-500/40 shadow-xl shadow-cyan-950/20' : 'border-slate-800 hover:border-slate-700'
}`}>
  <div>
    <!-- Top Bar / Badges -->
    <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
      <span class="text-[11px] font-bold uppercase tracking-wider text-cyan-400 font-mono bg-cyan-500/10 px-2.5 py-0.5 rounded border border-cyan-500/30">
        {category}
      </span>
      {featured && (
        <span class="text-[10px] font-bold uppercase tracking-wider text-amber-300 bg-amber-500/10 px-2 py-0.5 rounded border border-amber-500/30 flex items-center gap-1">
          <span>&starf;</span> Projeto em Destaque
        </span>
      )}
    </div>

    <!-- Título & Tagline -->
    <h3 class="text-xl sm:text-2xl font-black text-white hover:text-cyan-300 transition-colors">
      <a href={projectUrl}>
        {title}
      </a>
    </h3>
    <p class="text-xs sm:text-sm font-medium text-cyan-400/90 mt-1 mb-3">
      {tagline}
    </p>

    {resolvedCover && (
      <div class="mb-4 rounded-xl overflow-hidden border border-slate-800/80 max-h-56 bg-slate-950">
        <img src={resolvedCover} alt={title} class="w-full h-full object-cover opacity-90 hover:opacity-100 transition-opacity" loading="lazy" />
      </div>
    )}

    <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-5">
      {description}
    </p>

    <!-- Métricas Técnicas em Destaque -->
    {metrics.length > 0 && (
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 mb-5">
        {metrics.slice(0, 3).map((m) => (
          <div class="p-2.5 rounded-lg bg-slate-900/80 border border-slate-800">
            <div class="text-sm sm:text-base font-black text-cyan-300 font-mono">{m.value}</div>
            <div class="text-[10px] font-bold text-slate-300">{m.label}</div>
          </div>
        ))}
      </div>
    )}

    <!-- Tags de Tecnologias -->
    <div class="flex flex-wrap gap-1.5 mb-6">
      {tags.map((tag) => (
        <span class="text-[11px] font-medium bg-slate-900 text-slate-400 px-2 py-0.5 rounded border border-slate-800/80">
          {tag}
        </span>
      ))}
    </div>
  </div>

  <!-- Ações no Rodapé do Card -->
  <div class="pt-4 border-t border-slate-800/80 flex flex-wrap items-center justify-between gap-3">
    <a
      href={projectUrl}
      class="inline-flex items-center gap-1.5 text-xs font-extrabold text-cyan-300 hover:text-white bg-cyan-500/10 hover:bg-cyan-500/20 px-4 py-2 rounded-lg border border-cyan-500/30 transition-colors group"
    >
      <span>Acessar Estudo Completo &amp; Simulador</span>
      <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>

    {repoUrl && (
      <a
        href={repoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-400 hover:text-slate-200 transition-colors"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
        <span>Repositório</span>
      </a>
    )}
  </div>
</div>
