---
import { getUrl } from '../utils/url';

const navLinks = [
  { name: 'Início', href: getUrl('/') },
  { name: 'Sobre & CV', href: getUrl('/sobre') },
  { name: 'Projetos', href: getUrl('/projetos') },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 w-full border-b border-ctp-surface0/80 bg-ctp-mantle/85 backdrop-blur-lg">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Brand / Nome -->
    <a href={getUrl('/')} class="flex items-center gap-2.5 group">
      <div class="relative flex items-center justify-center w-8 h-8 rounded-lg bg-ctp-surface0/70 border border-ctp-sapphire/40 group-hover:border-ctp-sky transition-colors">
        <span class="w-2 h-2 rounded-full bg-ctp-sapphire animate-pulse"></span>
        <span class="absolute w-4 h-4 rounded-full border border-ctp-sapphire/40 animate-ping"></span>
      </div>
      <div>
        <div class="text-sm font-extrabold tracking-wider text-ctp-text group-hover:text-ctp-sky transition-colors">
          ANDRÉ LUIZ PIANCA
        </div>
        <div class="text-[10px] font-medium tracking-wide text-ctp-subtext0">
          UNICAMP &bull; Física &amp; Engenharia Física
        </div>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-1.5 text-xs font-semibold">
      {
        navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== getUrl('/') && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class={`px-3 py-1.5 rounded-lg transition-all flex items-center gap-1.5 ${
                isActive
                  ? 'text-ctp-sky bg-ctp-surface0 border border-ctp-sapphire/50 shadow-sm shadow-ctp-sapphire/10'
                  : 'text-ctp-subtext1 hover:text-ctp-text hover:bg-ctp-surface0/50'
              }`}
            >
              {link.name}
            </a>
          );
        })
      }
    </nav>

    <!-- Socials, Contato & Theme Switcher -->
    <div class="hidden sm:flex items-center gap-2.5">
      <!-- Theme Toggle Button -->
      <button
        type="button"
        class="theme-toggle-btn p-2 rounded-lg text-ctp-subtext0 hover:text-ctp-text hover:bg-ctp-surface0/80 transition-colors border border-transparent hover:border-ctp-surface1 cursor-pointer"
        aria-label="Alternar tema Catppuccin (Mocha / Latte)"
        title="Alternar tema Catppuccin (Mocha / Latte)"
      >
        <!-- Sun Icon (Mocha -> Latte) -->
        <svg class="theme-icon-sun w-4 h-4 text-ctp-yellow hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="5" stroke-width="2" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
        </svg>
        <!-- Moon Icon (Latte -> Mocha) -->
        <svg class="theme-icon-moon w-4 h-4 text-ctp-blue hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <a
        href="https://github.com/andrlupi"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="p-2 rounded-lg text-ctp-subtext0 hover:text-ctp-text hover:bg-ctp-surface0/80 transition-colors border border-transparent hover:border-ctp-surface1"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
      </a>

      <a
        href="https://linkedin.com/in/andre-lpianca"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="p-2 rounded-lg text-ctp-subtext0 hover:text-ctp-text hover:bg-ctp-surface0/80 transition-colors border border-transparent hover:border-ctp-surface1"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.6 1.6 0 1 0 0-3.2 1.6 1.6 0 0 0 0 3.2m1.4 9.74V10.13H5.06v8.37h2.8z" />
        </svg>
      </a>

      <a
        href="mailto:andre-lpianca@proton.me"
        class="px-3.5 py-1.5 rounded-lg text-xs font-bold text-ctp-crust bg-ctp-sapphire hover:bg-ctp-sky transition-colors shadow-sm shadow-ctp-sapphire/20"
      >
        Contato
      </a>
    </div>

    <!-- Mobile Actions (Theme Toggle & Menu Button) -->
    <div class="flex md:hidden items-center gap-1.5">
      <button
        type="button"
        class="theme-toggle-btn p-1.5 rounded-lg text-ctp-subtext0 hover:text-ctp-text hover:bg-ctp-surface0"
        aria-label="Alternar tema Catppuccin"
      >
        <svg class="theme-icon-sun w-4 h-4 text-ctp-yellow hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="5" stroke-width="2" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
        </svg>
        <svg class="theme-icon-moon w-4 h-4 text-ctp-blue hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <button
        id="mobile-menu-btn"
        type="button"
        class="p-2 rounded-lg text-ctp-subtext0 hover:text-ctp-text hover:bg-ctp-surface0 focus:outline-none"
        aria-label="Abrir menu"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-ctp-surface0 bg-ctp-mantle px-4 py-3 space-y-2 text-xs font-semibold">
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class="block px-3 py-2 rounded-lg text-ctp-subtext1 hover:text-ctp-sky hover:bg-ctp-surface0/60 transition-colors"
        >
          {link.name}
        </a>
      ))
    }
    <div class="pt-2 border-t border-ctp-surface0 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="https://github.com/andrlupi" target="_blank" class="text-ctp-subtext0 hover:text-ctp-text text-xs">GitHub</a>
        <a href="https://linkedin.com/in/andre-lpianca" target="_blank" class="text-ctp-subtext0 hover:text-ctp-text text-xs">LinkedIn</a>
      </div>
      <a href="mailto:andre-lpianca@proton.me" class="px-3 py-1 rounded bg-ctp-sapphire text-ctp-crust text-xs font-bold">
        Email
      </a>
    </div>
  </div>
</header>

<script>
  // Menu Mobile
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }

  // Catppuccin Theme Switcher (Mocha / Latte)
  function setupThemeToggle() {
    const toggleBtns = document.querySelectorAll<HTMLButtonElement>('.theme-toggle-btn');

    function updateIcons() {
      const isLatte = document.documentElement.classList.contains('latte');
      toggleBtns.forEach((b) => {
        const sun = b.querySelector('.theme-icon-sun');
        const moon = b.querySelector('.theme-icon-moon');
        if (sun && moon) {
          if (isLatte) {
            sun.classList.add('hidden');
            moon.classList.remove('hidden');
          } else {
            sun.classList.remove('hidden');
            moon.classList.add('hidden');
          }
        }
      });
    }

    toggleBtns.forEach((b) => {
      b.addEventListener('click', () => {
        const isLatte = document.documentElement.classList.contains('latte');
        if (isLatte) {
          document.documentElement.classList.remove('latte');
          document.documentElement.classList.add('dark');
          localStorage.setItem('catppuccin-theme', 'mocha');
        } else {
          document.documentElement.classList.remove('dark');
          document.documentElement.classList.add('latte');
          localStorage.setItem('catppuccin-theme', 'latte');
        }
        updateIcons();
      });
    });

    updateIcons();
  }

  document.addEventListener('DOMContentLoaded', setupThemeToggle);
  setupThemeToggle();
</script>
