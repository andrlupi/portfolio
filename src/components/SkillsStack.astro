---
const categories = [
  {
    id: "programacao",
    name: "Programação & Computação Científica",
    skills: [
      "Python",
      "Julia",
      "C",
      "MATLAB",
    ],
  },
  {
    id: "cad",
    name: "CAD, Simulação & Engenharia",
    skills: [
      "Autodesk Fusion 360 & Inventor",
      "AutoCAD & Desenho Técnico",
      "Simulink & Simscape",
      "Ansys (FEA)",
    ],
  },
  {
    id: "fisica",
    name: "Instrumentação & Física Aplicada",
    skills: [
      "Criogenia (< 10 K)",
      "Tecnologia de Vácuo",
      "Modelagem Térmica (Lumped-Mass)",
      "Transformada de Kirchhoff",
      "Solvers Não-Lineares (Newton-Raphson & Rosenbrock)",
      "Instrumentação Geral & Aquisição de Dados",
    ],
  },
  {
    id: "softskills",
    name: "Soft Skills & Ensino",
    skills: [
      "Divulgação Científica & Mediação",
      "Trabalho em Equipe & Liderança",
      "Planejamento e Gestão de Projetos",
      "Didática Experimental",
    ],
  },
];

const languages = [
  { name: "Português", level: "Nativo", badge: "Língua Materna", pct: 100 },
  { name: "Inglês", level: "Avançado", badge: "Comunicação Técnica & Acadêmica", pct: 85 },
  { name: "Espanhol", level: "Básico", badge: "Comunicação Essencial", pct: 40 },
  { name: "Chinês", level: "Básico", badge: "Comunicação Introdutória", pct: 30 },
];
---

<section id="skills" class="space-y-6 pt-4">
  <div class="border-b border-ctp-surface0 pb-3">
    <span class="text-xs font-bold uppercase tracking-wider text-ctp-sky font-mono">Competências &amp; Ferramentas</span>
    <h2 class="text-2xl sm:text-3xl font-extrabold text-ctp-text mt-1">Competências Técnicas</h2>
  </div>

  <!-- Painel Interativo com Seletor por Abas -->
  <div class="glass-panel p-6 sm:p-7 bg-ctp-mantle/85 border border-ctp-surface0 rounded-2xl shadow-xl shadow-ctp-crust/50 space-y-6">
    <!-- Seletor de Abas -->
    <div class="flex flex-wrap gap-2 border-b border-ctp-surface0/80 pb-4" id="skill-tabs-nav" role="tablist">
      <button
        type="button"
        role="tab"
        aria-selected="true"
        aria-controls="panel-todas"
        id="tab-todas"
        data-target="todas"
        class="skill-tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all border bg-ctp-surface0 text-ctp-sky border-ctp-sapphire/60 shadow-sm"
      >
        Todas as Competências
      </button>
      {
        categories.map((cat) => (
          <button
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls={`panel-${cat.id}`}
            id={`tab-${cat.id}`}
            data-target={cat.id}
            class="skill-tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all border bg-ctp-mantle text-ctp-subtext0 border-transparent hover:text-ctp-text hover:bg-ctp-surface0/50 hover:border-ctp-surface1"
          >
            {cat.name}
          </button>
        ))
      }
    </div>

    <!-- Conteúdo dos Painéis (Estilizados no padrão Soft Skills com Bullet e Pills) -->
    <div id="skill-panels-container">
      <!-- Painel "Todas as Competências" -->
      <div id="panel-todas" role="tabpanel" aria-labelledby="tab-todas" class="skill-panel space-y-6 block">
        {
          categories.map((cat) => (
            <div class="space-y-3">
              <div class="text-[11px] font-mono font-bold uppercase tracking-wider text-ctp-sky flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-ctp-sapphire"></span>
                {cat.name}
              </div>
              <div class="flex flex-wrap gap-2.5">
                {cat.skills.map((skill) => (
                  <span class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-ctp-surface0 text-ctp-text text-xs sm:text-sm font-medium border border-ctp-surface1 hover:border-ctp-sapphire/50 transition-all shadow-sm">
                    <span class="text-ctp-sapphire font-bold">&bull;</span>
                    {skill}
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>

      <!-- Painéis Individuais por Categoria -->
      {
        categories.map((cat) => (
          <div
            id={`panel-${cat.id}`}
            role="tabpanel"
            aria-labelledby={`tab-${cat.id}`}
            class="skill-panel space-y-3 hidden"
          >
            <div class="text-[11px] font-mono font-bold uppercase tracking-wider text-ctp-sky flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-ctp-sapphire"></span>
              {cat.name}
            </div>
            <div class="flex flex-wrap gap-2.5">
              {cat.skills.map((skill) => (
                <span class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-ctp-surface0 text-ctp-text text-xs sm:text-sm font-medium border border-ctp-surface1 hover:border-ctp-sapphire/50 transition-all shadow-sm">
                  <span class="text-ctp-sapphire font-bold">&bull;</span>
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Idiomas -->
  <div class="glass-panel p-6 bg-ctp-mantle/85 border border-ctp-surface0 rounded-2xl">
    <h3 class="text-xs font-bold uppercase tracking-wider text-ctp-sky font-mono mb-4 flex items-center gap-2">
      <svg class="w-4 h-4 text-ctp-sapphire" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
      </svg>
      Idiomas
    </h3>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {
        languages.map((lang) => (
          <div class="p-3.5 rounded-xl bg-ctp-surface0/50 border border-ctp-surface0/90">
            <div class="flex justify-between items-center mb-1">
              <span class="text-xs font-bold text-ctp-text">{lang.name}</span>
              <span class="text-[11px] font-mono text-ctp-sky font-semibold">{lang.level}</span>
            </div>
            <div class="text-[10px] text-ctp-subtext0 mb-2">{lang.badge}</div>
            <div class="w-full bg-ctp-crust rounded-full h-1.5 overflow-hidden">
              <div class="bg-gradient-to-r from-ctp-sky to-ctp-blue h-1.5 rounded-full" style={`width: ${lang.pct}%`}></div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  function setupSkillTabs() {
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('.skill-tab-btn');
    const panels = document.querySelectorAll<HTMLDivElement>('.skill-panel');

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-target');

        // Atualiza botões
        tabButtons.forEach((b) => {
          b.setAttribute('aria-selected', 'false');
          b.classList.remove('bg-ctp-surface0', 'text-ctp-sky', 'border-ctp-sapphire/60', 'shadow-sm');
          b.classList.add('bg-ctp-mantle', 'text-ctp-subtext0', 'border-transparent');
        });

        btn.setAttribute('aria-selected', 'true');
        btn.classList.remove('bg-ctp-mantle', 'text-ctp-subtext0', 'border-transparent');
        btn.classList.add('bg-ctp-surface0', 'text-ctp-sky', 'border-ctp-sapphire/60', 'shadow-sm');

        // Atualiza painéis
        panels.forEach((p) => {
          if (p.id === `panel-${target}`) {
            p.classList.remove('hidden');
            p.classList.add('block');
          } else {
            p.classList.add('hidden');
            p.classList.remove('block');
          }
        });
      });
    });
  }

  document.addEventListener('DOMContentLoaded', setupSkillTabs);
  setupSkillTabs();
</script>
